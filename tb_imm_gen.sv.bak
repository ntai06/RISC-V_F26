        `timescale 1ns / 10ps
        /* verilator coverage_off */

        module tb_imm_gen ();

            initial begin
                $dumpfile("waveform.vcd");
                $dumpvars;
            end

            
            // DUT interface signals
            logic [31:0] instr, immediate;
            string testcase;
            

            imm_gen DUT (
                .instr(instr),
                .immediate(immediate)
            );
            typedef struct {
                logic [31:0] instr;
                logic [31:0] result;
                string desc;
            } test_vector_t;

            
            test_vector_t test_vectors[7]='{
                '{32'h1230_0013, 32'h0000_0123, "I-type positive immediate"}, // imm = 0x123
                '{32'hFFF0_0013, 32'hFFFF_FFFF, "I-type negative immediate"}, // imm = -1
                '{32'h1200_2023, 32'h0000_0120, "S-type immediate"}, // imm = 0x120
                '{32'h0000_0863, 32'h0000_0010, "B-type immediate"}, // branch offset = 16
                '{32'h1234_5037, 32'h1234_5000, "U-type immediate"}, // imm = 0x12345000
                '{32'h0100_006F, 32'h0000_0010, "J-type immediate"}, // jump offset = 16
                '{32'h0000_0033, 32'h0000_0000, "R-type: zero"} //default case
            };
            initial begin
                // Initialize stimulus lines
                foreach(test_vectors[i]) begin
                    instr=test_vectors[i].instr;
                    immediate=test_vectors[i].result;
                    testcase=test_vectors[i].desc;
                    #10;
                    $display("Test case: %s",test_vectors[i].desc);
                    if(immediate!==test_vectors[i].result) begin

                        $display("Expected Result : %h, Actual result: %h",test_vectors[i].result,testcase);
                    end else begin
                        $display("Test Case: %s worked!",testcase);
                    end
                end 
                
                $stop;
            end

        endmodule

        /* verilator coverage_on */